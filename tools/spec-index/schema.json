{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChronLLMPhysicalSpecFactRecord",
  "type": "object",
  "required": [
    "path",
    "sha256",
    "size",
    "lines",
    "content_state",
    "module",
    "version",
    "raw_status",
    "extends",
    "uses",
    "defines",
    "declares",
    "operations",
    "invariants",
    "theorems",
    "policies",
    "contracts",
    "excludes",
    "boundary_claims",
    "structure",
    "fact_only"
  ],
  "properties": {
    "path": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size": { "type": "integer", "minimum": 0 },
    "lines": { "type": "integer", "minimum": 0 },
    "content_state": { "type": "string", "enum": ["EMPTY", "NON_EMPTY"] },
    "module": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "raw_status": { "type": "string" },
    "extends": { "type": "array", "items": { "type": "string" } },
    "uses": { "type": "array", "items": { "type": "string" } },
    "defines": { "type": "array", "items": { "type": "string" } },
    "declares": { "type": "array", "items": { "type": "string" } },
    "operations": { "type": "array", "items": { "type": "string" } },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "theorems": { "type": "array", "items": { "type": "string" } },
    "policies": { "type": "array", "items": { "type": "string" } },
    "contracts": { "type": "array", "items": { "type": "string" } },
    "excludes": { "type": "array", "items": { "type": "string" } },
    "boundary_claims": { "type": "array", "items": { "type": "string" } },
    "structure": {
      "type": "object",
      "required": ["sections", "comment_lines", "non_comment_lines"],
      "properties": {
        "sections": { "type": "array", "items": { "type": "string" } },
        "comment_lines": { "type": "integer", "minimum": 0 },
        "non_comment_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "fact_only": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
