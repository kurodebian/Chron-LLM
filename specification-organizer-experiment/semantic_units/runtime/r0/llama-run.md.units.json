      "line_start": 158,
      "line_end": 160,
      "source_text": "```\n/home/junu/lisp-os/llama.cpp/build/bin/llama-completion\n```\n"
    },
    {
      "unit_id": "u0045",
      "line_start": 162,
      "line_end": 162,
      "source_text": "モデル\n"
    },
    {
      "unit_id": "u0046",
      "line_start": 164,
      "line_end": 166,
      "source_text": "```\n/home/junu/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf\n```\n"
    },
    {
      "unit_id": "u0047",
      "line_start": 168,
      "line_end": 168,
      "source_text": "実行オプション\n"
    },
    {
      "unit_id": "u0048",
