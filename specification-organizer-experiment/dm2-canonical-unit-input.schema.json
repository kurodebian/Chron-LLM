{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chron-llm.local/schema/dm2-canonical-unit-input.schema.json",
  "title": "DM-2 Canonical Unit Input",
  "description": "Canonical A-1a-N unit consumed by DM-2 semantic extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "line_start",
    "line_end",
    "source_text"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^u[0-9]{4}$",
      "description": "Canonical unit identifier assigned by A-1a-N."
    },
    "line_start": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based inclusive source-document start line."
    },
    "line_end": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based inclusive source-document end line."
    },
    "source_text": {
      "type": "string",
      "description": "Exact source text regenerated by A-1a-N."
    }
  }
}
