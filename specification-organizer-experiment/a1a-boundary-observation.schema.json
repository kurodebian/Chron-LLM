{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chron-llm.local/schema/a1a-boundary-observation.schema.json",
  "title": "A-1a-O Boundary Observation",
  "description": "Structural contract for raw A-1a-O boundary observations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["boundaries"],
  "properties": {
    "boundaries": {
      "type": "array",
      "description": "Ordered raw boundary span observations.",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_start", "line_end"],
      "properties": {
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based inclusive start line number."
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based inclusive end line number."
        }
      }
    }
  }
}
